-- Adder.vhd
-------------------------------------------------------------------------
-- DESCRIPTION: This file contains an implementation of a behavioral 
-- signed adder operating on std_logic_vector inputs. 
--
--
-- NOTES: For simplicity, we caslibrary IEEE;


library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_ARITH.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity MIPS_ALU is
    Port (
        A         : in  std_logic_vector(31 downto 0);
        B         : in  std_logic_vector(31 downto 0);
        ALUCtrl   : in  std_logic_vector(3 downto 0);
        F         : out std_logic_vector(31 downto 0);
        CarryOut  : out std_logic;
        Overflow  : out std_logic;
        Zero      : out std_logic
    );
end MIPS_ALU;

architecture Structural of MIPS_ALU is

    -- Signals to connect internal components
    signal alu_out      : std_logic_vector(31 downto 0);
    signal shift_out    : std_logic_vector(31 downto 0);
    signal shamt        : std_logic_vector(4 downto 0);
    signal shift_sel    : std_logic;
    signal alu_CarryOut : std_logic;
    signal alu_Overflow : std_logic;

    component alu
        Port (
            A        : in  std_logic_vector(31 downto 0);
            B        : in  std_logic_vector(31 downto 0);
            ALUCtrl  : in  std_logic_vector(3 downto 0);
            Result   : out std_logic_vector(31 downto 0);
            CarryOut : out std_logic;
            Overflow : out std_logic
        );
    end component;

    component BarrelShifter32
        Port (
            input  : in  std_logic_vector(31 downto 0);
            shamt  : in  std_logic_vector(4 downto 0);
            dir    : in  std_logic;
            arith  : in  std_logic;
            result : out std_logic_vector(31 downto 0)
        );
    end component;

begin
    -- Shift amount comes from A(4 downto 0) for variable shift
    shamt <= A(4 downto 0);

    -- Instantiate arithmetic/logic ALU
    coreALU: alu
        port map (
            A        => A,
            B        => B,
            ALUCtrl  => ALUCtrl,
            Result   => alu_out,
            CarryOut => alu_CarryOut,
            Overflow => alu_Overflow
        );

    -- Instantiate barrel shifter
    shifter: BarrelShifter32
        port map (
            input  => B,
            shamt  => shamt,
            dir    => ALUCtrl(0),    -- example: 0 = left, 1 = right
            arith  => ALUCtrl(1),    -- example: 1 = arithmetic, 0 = logical
            result => shift_out
        );

    -- Select between ALU or Shift result based on ALUCtrl
    process(ALUCtrl, alu_out, shift_out)
    begin
        case ALUCtrl is
            when "1000" | "1001" | "1010" | "1011" | "1100" | "1101" =>  -- shift ops
                F <= shift_out;
            when others =>
                F <= alu_out;
        end case;
    end process;

    -- Outputs
    CarryOut <= alu_CarryOut;
    Overflow <= alu_Overflow;
    Zero <= '1' when F = x"00000000" else '0';

end Structural;
