-- Adder.vhd
-------------------------------------------------------------------------
-- DESCRIPTION: This file contains an implementation of a behavioral 
-- signed adder operating on std_logic_vector inputs. 
--
--
-- NOTES: For simplicity, we cast to signed values before operating and cast back.
-- This design does not handle overflow.


-- 8/19/09 by JAZ::Design created.
-- 1/16/25 by CWS::Switched from integer to std_logic_vector and numeric_std.
-------------------------------------------------------------------------

library IEEE;
use IEEE.std_logic_1164.all;

entity Control_Unit is
  port(
    iOpcode     : in  std_logic_vector(5 downto 0);
    iFunct      : in  std_logic_vector(5 downto 0);

    -- Output control signals
    oRegWrite   : out std_logic;
    oMemtoReg   : out std_logic;
    oMemWrite   : out std_logic;
    oMemRead    : out std_logic;
    oRegDst     : out std_logic;
    oALUSrc     : out std_logic;
    oALUOp : out std_logic_vector(3 downto 0);
    oBranch     : out std_logic;
    --oBne        : out std_logic;
    oJump       : out std_logic
    --oJumpReg    : out std_logic;
    --oLink       : out std_logic
  );
end Control_Unit;

architecture Behavioral of Control_Unit is
begin
  process(iOpcode, iFunct)
  begin
    -- Default values
    oRegWrite   <= '0';
    oMemtoReg   <= '0';
    oMemWrite   <= '0';
    oMemRead    <= '0';
    oRegDst     <= '0';
    oALUSrc     <= '0';
    oALUOp <= "0000";
    oBranch     <= '0';
    --oBne        <= '0';
    oJump       <= '0';
    --oJumpReg    <= '0';
    --oLink       <= '0';

    case iOpcode is
      when "000000" => 			-- R-type
        case iFunct is
          when "100000" => -- add
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "0010";
          when "100010" => -- sub
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "0110";
          when "101010" => -- slt
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "0111";
          when "100100" => -- and
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "0000";
          when "100101" => -- or
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "0001";
          when "000000" => -- sll
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "1000";
          when "000010" => -- srl
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUSrc <= '1'; oALUOp <= "1001";
          when "000011" => -- sra
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUSrc <= '1'; oALUOp <= "1010";
          when "000100" => -- sllv
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "1000";
          when "000110" => -- srlv
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "1001";
          when "000111" => -- srav
            oRegWrite <= '1'; 
        oRegDst <= '1'; 
        oALUOp <= "1010";
          when "001000" => -- jr
            --oJumpReg <= '1';
          when others => null;
        end case;

      when "001000" => -- addi
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "0010";
      when "001001" => -- addiu
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "0010";
      when "001100" => -- andi
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "0000";
      when "001101" => -- ori
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "0001";
      when "001010" => -- slti
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "0111";
      when "001111" => -- lui
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "1111";

      when "100011" => -- lw
        oRegWrite <= '1'; 
        oALUSrc <= '1'; 
        oMemRead <= '1'; 
        oMemtoReg <= '1'; 
        oALUOp <= "0010";
      when "101011" => -- sw
        oMemWrite <= '1'; 
        oALUSrc <= '1'; 
        oALUOp <= "0010";

      when "000100" => -- beq
        oBranch <= '1'; 
        oALUOp <= "0110";
      when "000101" => -- bne
        --oBne <= '1'; 
        oALUOp <= "0110";
      when "000010" => -- j
        oJump <= '1';
      when "000011" => -- jal
        oJump <= '1'; 
        oRegWrite <= '1'; 
        --oLink <= '1';

      when others => null;
    end case;
  end process;
end Behavioral;

