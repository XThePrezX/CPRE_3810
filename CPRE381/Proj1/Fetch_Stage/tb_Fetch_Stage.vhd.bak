library IEEE;
use IEEE.std_logic_1164.all;
use IEEE.numeric_std.all;

entity tb_Fetch_Stage is
end tb_Fetch_Stage;

architecture behavior of tb_Fetch_Stage is

  -- Constants
  constant CLK_PERIOD : time := 10 ns;

  -- Component declaration
  component Fetch_Stage
    port (
      iClk          : in  std_logic;
      iRst          : in  std_logic;
      iBranch       : in  std_logic;
      iBranchTaken  : in  std_logic;
      iJump         : in  std_logic;
      iJumpReg      : in  std_logic;
      iBranchTarget : in  std_logic_vector(31 downto 0);
      iJumpTarget   : in  std_logic_vector(31 downto 0);
      iJRTarget     : in  std_logic_vector(31 downto 0);
      oPC           : out std_logic_vector(31 downto 0);
      oPC_Plus4     : out std_logic_vector(31 downto 0)
    );
  end component;

  -- Testbench signals
  signal clk          : std_logic := '0';
  signal rst          : std_logic := '1';
  signal branch       : std_logic := '0';
  signal branchTaken  : std_logic := '0';
  signal jump         : std_logic := '0';
  signal jumpReg      : std_logic := '0';
  signal branchTarget : std_logic_vector(31 downto 0) := x"00000010";
  signal jumpTarget   : std_logic_vector(31 downto 0) := x"00400000";
  signal jrTarget     : std_logic_vector(31 downto 0) := x"00003000";
  signal pc_out       : std_logic_vector(31 downto 0);
  signal pc_plus4     : std_logic_vector(31 downto 0);

begin

  -- Instantiate the DUT
  DUT: Fetch_Stage
    port map (
      iClk          => clk,
      iRst          => rst,
      iBranch       => branch,
      iBranchTaken  => branchTaken,
      iJump         => jump,
      iJumpReg      => jumpReg,
      iBranchTarget => branchTarget,
      iJumpTarget   => jumpTarget,
      iJRTarget     => jrTarget,
      oPC           => pc_out,
      oPC_Plus4     => pc_plus4
    );

  -- Clock process
  clk_process :process
  begin
    clk <= '0';
    wait for CLK_PERIOD/2;
    clk <= '1';
    wait for CLK_PERIOD/2;
  end process;

  -- Stimulus process
  stim_proc: process
  begin
    -- Apply reset
    wait for CLK_PERIOD;
    rst <= '1';
    wait for CLK_PERIOD;
    rst <= '0';

    -- Step 1: Regular PC + 4
    wait for CLK_PERIOD;

    -- Step 2: Branch taken
    branch <= '1';
    branchTaken <= '1';
    branchTarget <= x"00000020";
    wait for CLK_PERIOD;
    branch <= '0';
    branchTaken <= '0';

    -- Step 3: Unconditional jump
    jump <= '1';
    jumpTarget <= x"00400004";
    wait for CLK_PERIOD;
    jump <= '0';

    -- Step 4: Jump Register
    jumpReg <= '1';
    jrTarget <= x"00003010";
    wait for CLK_PERIOD;
    jumpReg <= '0';

    -- Step 5: Normal PC + 4 again
    wait for CLK_PERIOD;

    wait;
  end process;

end behavior;
